# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Never put real values in THIS file: it is not ignored.
# Use SANDBOX keys while developing. Prefer restricted keys (rk_) over secret keys (sk_).

# Stripe (server-side only: Supabase Edge Functions, never in browser code)
STRIPE_SECRET_KEY=rk_test_replace_me
# whsec_... from `stripe listen` or Dashboard > Webhooks > endpoint > Signing secret (not a URL)
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Stripe (public, safe for browser)
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Email (Resend). Without RESEND_API_KEY the functions skip sending, nothing breaks.
RESEND_API_KEY=re_replace_me
EMAIL_FROM=2ACE <hello@2ace.pl>
LEAD_NOTIFY_TO=warsaw@2ace.eu
