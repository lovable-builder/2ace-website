# Hide dotfiles/dot-folders (.git, .env, .agents ...) and non-site folders from the web
RedirectMatch 404 /\.(?!well-known)
RedirectMatch 404 ^/(supabase|node_modules)(/|$)
RedirectMatch 404 ^/skills-lock\.json$

# Clean URLs: /platform instead of /platform.html, / instead of /index.html
RewriteEngine On
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]
