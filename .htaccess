# Hide dotfiles/dot-folders (.git, .env, .agents ...) and non-site folders from the web
RedirectMatch 404 /\.(?!well-known)
RedirectMatch 404 ^/(supabase|node_modules|content|scripts|tests|web)(/|$)
RedirectMatch 404 ^/skills-lock\.json$

# Clean URLs: /about instead of /about.html, / instead of /index.html
RewriteEngine On
# One address for the site: www goes to the bare domain, so search engines and link previews see a single canonical host.
RewriteCond %{HTTP_HOST} ^www\.2ace\.pl$ [NC]
RewriteRule ^ https://2ace.pl%{REQUEST_URI} [R=301,L]
# 2ACE Market is switched off for now: its page and files are kept, but visitors go to the home page. Remove this rule to bring it back.
RewriteRule ^market(\.html)?/?$ / [R=302,L]
# The customer app (built from web/ into app/): every /app/... address is the same page, and the app shows the right screen.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^app(/.*)?$ /app/index.html [L]
# The old plan builder (/platform) is gone: its address, and the ?checkout= / ?domain= / ?view= links Stripe and older emails
# use, open the customer app, which reads those links and shows the right screen.
RewriteRule ^platform(\.html)?/?$ /app/ [R=302,L,QSA]
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

AddType application/manifest+json .webmanifest

# Our pages and scripts change often: always revalidate so visitors never run a stale copy next to new HTML.
<IfModule mod_headers.c>
  # Pictures rarely change: keep them in the browser for 30 days so repeat visits do not download the scroll frames again.
  <FilesMatch "\.(jpe?g|png|webp|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
