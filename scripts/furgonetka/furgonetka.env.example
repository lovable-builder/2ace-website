# Copy to .env and fill in. Never commit .env.
# Start on sandbox; switch to production only once labels print correctly.
FURGONETKA_ENV=sandbox

# From https://furgonetka.pl/api/aplikacje-oauth (app "2ACE").
# The sandbox has its OWN account and its OWN app -> different pair of keys.
FURGONETKA_CLIENT_ID=
FURGONETKA_CLIENT_SECRET=

# The Furgonetka account login + password (password grant).
FURGONETKA_USERNAME=2ace.sp.zoo@gmail.com
FURGONETKA_PASSWORD=
